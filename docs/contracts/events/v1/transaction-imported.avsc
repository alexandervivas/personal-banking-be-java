{
  "type": "record",
  "name": "TransactionImported",
  "namespace": "com.eureckah.banking.events.v1",
  "doc": "Event emitted when a transaction is imported from a bank/source",
  "fields": [
    { "name": "eventId", "type": "string", "doc": "Unique event identifier (UUID)" },
    { "name": "occurredAt", "type": "string", "doc": "RFC3339 timestamp of when the event occurred" },
    { "name": "tenantId", "type": "string" },
    { "name": "accountId", "type": "string" },
    { "name": "transactionId", "type": "string" },
    { "name": "bankId", "type": "string" },
    { "name": "sourceId", "type": "string" },
    { "name": "bookingDate", "type": "string" },
    { "name": "amount", "type": "double" },
    { "name": "currency", "type": "string" }
  ]
}
